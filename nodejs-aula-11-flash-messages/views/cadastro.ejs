<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<% if (messages.danger) { %>
    <div class="alert alert-danger flash-message alert-dismissible fade show">
        <button class="btn-close" data-bs-dismiss="alert"></button>
        <%= messages.danger %>
    </div>
<% } %>

<div class="container col-12 col-md-12">
    <div class="card mt-4">
        <div class="card-header">
            <h2>Cadastro de Usuário</h2>
        </div>
        <div class="card-body">
        
        <!-- Formulário de cadastro -->
            <form action="/cadastro/novo" method="post">
                <!-- E-mail -->
                <label for="email">E-mail</label>
                <input type="email" id="email" class="form-control" name="email" placeholder="Digite seu e-mail" required>
                
                <!-- Senha -->
                <label for="password">Senha</label>
                <input type="password" class="form-control" name="password" id="password" placeholder="Digite sua senha" required>

                <!-- Botão de enviar -->
                <button type="submit" class="btn btn-success btn-block mt-2">
                    Cadastrar
                </button>
            </form>
            <hr>
            <h6>Já possui conta?</h6> <a href="/login">Faça o login</a>
        </div>
    </div>
</div>

<%- include ('partials/footer.ejs') %>