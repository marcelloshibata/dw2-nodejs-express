<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

    <!-- Formulário de cadastro de Produtos -->
        <div class="container">
            <div class="card">
                <div class="card-header">
                    <h1>Cadastrar Produto</h1>
                </div>
                <div class="card-body">
                    <!-- Action: para onde os dados serão enviados -->
                     <!-- O método "POST": Método HTTP que envia dados de forma oculta -->
                    <form action="/produtos/cadastrar" method="POST">
                        <label for="nome">Nome do Produto:</label>
                        <input type="text" id="nome" name="nome" placeholder="Insira o nome do Produto"
                        class="form-control" required>

                        <label for="preco">Valor do Produto:</label>
                        <input type="text" id="preco" name="preco"
                        placeholder="Insira o valor do produto" class="form-control" required>

                        <label for="categoria">Categoria do Produto:</label>
                        <input type="text" id="categoria" name="categoria"
                        placeholder="Insira a categoria do produto" class="form-control" required>
                        <br>

                        <!-- Botão de cadastrar -->
                        <button type="submit"
                        class="btn btn-success">Cadastrar</button>
                        <!-- Botão de limpar -->
                        <button type="reset"
                        class="btn btn-danger">Limpar</button>
                    </form>
                    <hr>
                </div>
            </div>
        </div>
        <br>

    <div class="container">
        <div class="card">
            <div class="card-header">
                <h1>Produtos</h1>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th></th>
                            <th>Nome:</th>
                            <th>Preço:</th>
                            <th>Categoria:</th>
                            <th colspan="2" style="text-align: center;">Ações:</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% produtos.forEach(produto => { %>
                        <tr>
                            <td><img src="imgs/product.png" width="30px"></td>
                            <td><%= produto.nome %></td>
                            <td><%= produto.preco.toLocaleString('pt-br', {style: 'currency', currency: 'BRL'}) %></td>
                            <td><%= produto.categoria %></td>
                            <td>
                                <a href="/produtos/editar/<%= produto.id %>" class="btn btn-warning">Editar</a>
                            </td>
                            <td>
                                <a href="/produtos/excluir/<%= produto.id %>" class="btn btn-danger"
                                    onclick="return confirm('Deseja mesmo excluir o produto <%= produto.nome %>?')">Excluir</a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<%- include ('partials/footer.ejs') %>
