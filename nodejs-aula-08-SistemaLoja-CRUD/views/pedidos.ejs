<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

    <!-- Formulário de cadastro de Pedidos -->
        <div class="container">
            <div class="card">
                <div class="card-header">
                    <h1>Cadastrar Pedido</h1>
                </div>
                <div class="card-body">
                    <!-- Action: para onde os dados serão enviados -->
                     <!-- O método "POST": Método HTTP que envia dados de forma oculta -->
                    <form action="/pedidos/cadastrar" method="POST">
                        <label for="num">Número do Pedido:</label>
                        <input type="text" id="num" name="num" placeholder="Insira o número do pedido"
                        class="form-control" required>

                        <label for="valor">Valor total do pedido:</label>
                        <input type="text" id="valor" name="valor"
                        placeholder="Insira o valor do pedido" class="form-control" required>
                        <br>

                        <!-- Botão de cadastrar -->
                        <button type="submit"
                        class="btn btn-success">Cadastrar</button>
                        <!-- Botão de limpar -->
                        <button type="reset"
                        class="btn btn-danger">Limpar</button>
                    </form>
                    <hr>
                </div>
            </div>
        </div>
        <br>

    <div class="container">
        <div class="card">
            <div class="card-header">
                <h1>Pedidos</h1>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th></th>
                            <th>Número:</th>
                            <th>Valor:</th>
                            <th colspan="2" style="text-align: center;">Ações:</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% pedidos.forEach(pedido => { %>
                        <tr>
                            <td><img src="imgs/order.png" width="30px"></td>
                            <td><%= pedido.numero %></td>
                            <td><%= pedido.valor.toLocaleString('pt-br', {style: 'currency', currency: 'BRL'}) %></td>
                            <td>
                                <a href="/pedidos/editar/<%= pedido.id %>" class="btn btn-warning">Editar</a>
                            </td>
                            <td>
                                <a href="/pedidos/excluir/<%= pedido.id %>" class="btn btn-danger"
                                    onclick="return confirm('Deseja mesmo excluir o pedido <%= pedido.numero %>?')">Excluir</a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<%- include ('partials/footer.ejs') %>
